# ==============================================================================
# CareerPulse - Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=job_app_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/job_app_manager
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_postgres_password_here

# JWT Security Configuration
# Must be at least 256 bits (32 bytes) for HMAC-SHA256 signature security
JWT_SECRET=YourSuperSecretKeyForCareerPulseJWTAuthenticationMustBeLongerThan32Chars
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JPA / Hibernate Configuration
JPA_DDL_AUTO=validate
SHOW_SQL=false

# Frontend Configuration
VITE_API_URL=/api

